{
  "name": "flash-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FLASH Backend — Fastify + PostgreSQL + AI",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "catalog:sync": "tsx src/scripts/sync-catalog.ts",
    "seed:atlas": "tsx src/seed-atlas.ts",
    "backup": "tsx scripts/backup-db.ts",
    "admin:setup": "tsx scripts/setup-owner.ts",
    "test:golden": "tsx scripts/golden-tests.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
