{
  "name": "flash-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FLASH Backend — Fastify + PostgreSQL + AI",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "seed:atlas": "tsx src/seed-atlas.ts",
    "seed:atlas": "tsx src/seed-atlas.ts",
    "seed:atlas": "tsx src/seed-atlas.ts"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
