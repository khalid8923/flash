{
    "name":  "flash-backend",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "FLASH Backend â€” Fastify + PostgreSQL + AI",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc --noEmit",
                    "migrate":  "tsx src/migrate.ts",
                    "seed":  "tsx src/seed.ts",
                    "catalog:sync":  "tsx src/scripts/sync-catalog.ts",
                    "seed:atlas":  "tsx src/seed-atlas.ts",
                    "backup":  "tsx scripts/backup-db.ts",
                    "admin:setup":  "tsx scripts/setup-owner.ts",
                    "test:golden":  "tsx scripts/golden-tests.ts",
                    "test":  "vitest",
                    "test:run":  "vitest run",
                    "test:coverage":  "vitest run --coverage"
                },
    "dependencies":  {
                         "@fastify/compress":  "^9.2.2",
                         "@fastify/cors":  "^11.3.1",
                         "@fastify/helmet":  "^13.2.0",
                         "@fastify/multipart":  "^10.1.4",
                         "@fastify/rate-limit":  "^11.2.1",
                         "dotenv":  "^18.0.8",
                         "fastify":  "^5.12.7",
                         "pg":  "^8.13.1",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.9.0",
                            "@types/pg":  "^8.11.10",
                            "@vitest/coverage-v8":  "^2.1.9",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.6.3",
                            "vitest":  "^2.1.9"
                        },
    "engines":  {
                    "node":  "\u003e=20.0.0"
                }
}