# =======================================================
# FLASH Backend - Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.
# =======================================================

# ---- Server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/flashdb?sslmode=require

# ---- Auth (Better Auth / sessions) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-random-64-chars
AUTH_URL=http://localhost:3000

# ---- Admin API ----
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me-to-random-hex

# ---- AI - Groq (primary) ----
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL_EN=openai/gpt-oss-120b
GROQ_MODEL_AR=allam-2-7b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# ---- AI - OpenRouter (fallback) ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ---- AI - Google Gemini (fallback 2) ----
# Note: new key format (AQ.Ab8RN6...) - use x-goog-api-key header
GEMINI_API_KEY=AQ.Ab8RN6_xxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# ---- Voice (Whisper transcription) ----
VOICE_MODEL=whisper-large-v3-turbo
VOICE_MAX_BYTES=10485760

# ---- Email (Resend) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=FLASH <noreply@flash.app>

# ---- Frontend (CORS) ----
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,https://flash.pages.dev

# ---- Backups ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_KEY=change-me-32-byte-base64-key
BACKUP_DIR=./backups
BACKUP_KEEP_LAST=7


# =======================================================
# Architecture Providers (Phase 1 Abstraction Layers)
# =======================================================
# Free tier values below. Change to scale without code edits.
#
# CACHE:       memory | redis
# QUEUE:       inline | db
# STORAGE:     postgres | s3
# IDEMPOTENCY: memory | db
# LOCK:        postgres | redis
CACHE_PROVIDER=memory
QUEUE_PROVIDER=inline
STORAGE_PROVIDER=postgres
IDEMPOTENCY_PROVIDER=db
LOCK_PROVIDER=postgres

# Optional - only needed when providers above are redis/s3
# REDIS_URL=redis://localhost:6379
# S3_BUCKET=flash-blobs
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# =======================================================
# Demo Mode (NEVER enable in production)
# =======================================================
# When true: unauthenticated POST /sessions uses a demo user.
# Use ONLY for investor demos and local testing.
DEMO_MODE=false
