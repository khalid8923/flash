# ═══════════════════════════════════════════════════════
# FLASH Backend — Environment Variables
# انسخ الملف ده لـ .env وعدّل القيم
# ═══════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/flash?sslmode=require

# Auth (Better Auth)
AUTH_SECRET=change-me-to-random-32-chars
AUTH_URL=http://localhost:3000

# AI — Groq (primary)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# AI — OpenRouter (fallback)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=FLASH <noreply@flash.app>

# Frontend
CORS_ORIGIN=http://localhost:5173,https://flash.pages.dev
