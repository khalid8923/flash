<script>
/* Wire up theme + lang buttons after core is ready */
document.addEventListener('DOMContentLoaded', function(){
  var F = window.FLASH;
  var th = document.getElementById('th');
  if (th) th.addEventListener('click', function(){
    var next = F.state.theme === 'dark' ? 'light' : 'dark';
    var TT = window.FLASH_MODULES && window.FLASH_MODULES.themeTransition;
    if (TT){
      TT.transition(next, th, function(){
        F.setTheme(next);
        window.dispatchEvent(new Event('flash:render'));
      });
    } else {
      F.toggleTheme();
      window.dispatchEvent(new Event('flash:render'));
    }
  });

  document.querySelectorAll('.lg button').forEach(function(b){
    b.addEventListener('click', function(){
      var next = b.dataset.l;
      var LF = window.FLASH_MODULES && window.FLASH_MODULES.langFlip;
      if (LF){
        LF.flip(next, function(){ F.setLang(next); });
      } else {
        F.setLang(next);
        window.dispatchEvent(new Event('flash:render'));
      }
    });
  });
});
</script>

