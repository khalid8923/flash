<body>

<div class="shell">

  <header class="hdr">
    <span class="wm">FLASH</span>
    <div class="tools">
      <button id="th" class="th" type="button" aria-label="Switch theme">
        <svg class="sn" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="mn" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
        </svg>
      </button>
      <div class="lg">
        <button type="button" data-l="en" aria-pressed="true">EN</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-l="ar" aria-pressed="false">AR</button>
      </div>
    </div>
  </header>

  <main class="main" id="app"></main>

  <footer class="ft" id="foot"></footer>

</div>

