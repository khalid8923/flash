/* ═══════════════════════════════════════════════════════════
   MODULE — Recent Sessions Panel
   ═══════════════════════════════════════════════════════════ */
(function(){
'use strict';
const F = window.FLASH;
const M = F.M;

function render(){
  const t = F.t, n = F.N, DF = F.DF, pc = F.pc;
  const sess = Array.isArray(M && M.recentSessions) ? M.recentSessions : [];
  const doms = Array.isArray(M && M.domains) ? M.domains : [];

  const rows = sess.map(s => {
    const safe = s || {};
    const d = doms.find(x => x && x.id === safe.domain) || { c: "#888", name_en: "Unknown", name_ar: "Unknown" };
    const game = (safe['game_' + F.state.lang] || safe.game_en) || 'Unknown';
    const domName = (d && (d['name_' + F.state.lang] || d.name_en)) || 'Unknown';
    const delta = (typeof safe.deltaVsPB === "number") ? safe.deltaVsPB : 0;
    const deltaStr = (delta > 0 ? '+' : '−') + Math.abs(delta).toFixed(1);
    const pb = delta > 0;

    return `
      <tr style="--dc:${d.c}">
        <td>${DF(safe.date || '')}</td>
        <td>${game}</td>
        <td><span class="tr-dot"></span>${domName}</td>
        <td class="num">${pc(safe.accuracy || 0)}</td>
        <td class="num">${n(safe.medianRT || 0)} ${t('ms')}</td>
        <td class="num">${deltaStr}${pb ? '<span class="pb-tag">PB</span>' : ''}</td>
      </tr>
    `;
  }).join('');
  return `
      <tr style="--dc:${d.c}">
        <td>${DF(s.date)}</td>
        <td>${game}</td>
        <td><span class="tr-dot"></span>${domName}</td>
        <td class="num">${pc(s.accuracy)}</td>
        <td class="num">${n(s.medianRT)} ${t('ms')}</td>
        <td class="num">${deltaStr}${pb ? '<span class="pb-tag">PB</span>' : ''}</td>
      </tr>
    `;
  }).join('');

  return `
    <div class="recent-h">
      <h2>${t('rec')}</h2>
      <span class="cnt"><a href="sessions.html" style="color:inherit;text-decoration:underline;text-underline-offset:3px;">${n(M.recentSessions.length)} →</a></span>
    </div>
    <table class="tbl">
      <thead><tr>
        <th>${t('dt')}</th>
        <th>${t('gm')}</th>
        <th>${t('dm')}</th>
        <th class="num">${t('ac')}</th>
        <th class="num">${t('rt')}</th>
        <th class="num">${t('pb')}</th>
      </tr></thead>
      <tbody>${rows}</tbody>
    </table>
  `;
}

window.FLASH_MODULES = window.FLASH_MODULES || {};
window.FLASH_MODULES.recent = { render };
})();